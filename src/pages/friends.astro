---
import BaseLayout from '@layouts/BaseLayout.astro'
import SidebarCard from '@components/SidebarCard.vue'
import ThemeSwitcher from '@components/ThemeSwitcher.vue'
import { getCollection, getEntry } from 'astro:content'
import friends from '../data/friends.json'
import { siteConfig } from 'src/site.config'

const posts = await getCollection('posts')
posts.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const postsCount = posts.length
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of posts) { (p.data.tags || []).forEach((t) => { tagSet.add(t); tagCount.set(t, (tagCount.get(t) || 0) + 1) }) }
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,50).map(([name,count]) => ({ name, count }))
const recommendations = posts.slice(0,50).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice
const entry = await getEntry('pages', 'friends')
const { Content, headings } = await entry.render()
---
<BaseLayout title={entry.data.title}>
  <div class="page-grid">
    <div id="home-hero" class="hero-card">
      <img class="hero-img" src={siteConfig.hero.bg} alt="头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <div class="hero-title">{entry.data.title}</div>
        <div class="hero-desc">{entry.data.description || ''}</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} notice={notice} headings={headings} />
    <ThemeSwitcher client:only="vue" />
    <article id="pjax-container" class="post">
      <div class="post-header">
        <div class="post-title-box">
          <h1 class="post-title">{entry.data.title}</h1>
          <div class="post-submeta">{entry.data.description || ''}</div>
        </div>
      </div>
      <div class="post-content-card">
        <div class="prose">
          <Content />
          {(() => {
            const items = [...friends].sort(() => Math.random() - 0.5)
            function colorOf(name: string) {
              const seed = Array.from(name).reduce((s, c) => s + c.charCodeAt(0), 0) % 360
              return `hsl(${seed}, 65%, 94%)`
            }
            return (
              <div class="friends">
                {items.map((f) => (
                  <a href={f.url} target="_blank" rel="noopener" class="friend-item" style={{ background: colorOf(f.name) }}>
                    <div class="friend-content">
                      <div class="friend-name">{f.name}</div>
                      <div class="friend-desc">{f.desc}</div>
                    </div>
                    {f.avatar && <img src={f.avatar} alt={f.name} class="friend-avatar" />}
                  </a>
                ))}
              </div>
            )
          })()}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
