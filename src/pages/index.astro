---
import BaseLayout from '@layouts/BaseLayout.astro'
import TagFilter from '@components/TagFilter.vue'
import PaginationNav from '@components/PaginationNav.vue'
import SidebarCard from '@components/SidebarCard.vue'
import { getCollection } from 'astro:content'

const PAGE_SIZE = 9
const all = await getCollection('posts')
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const total = all.length
const slice = all.slice(0, PAGE_SIZE)
const clientPosts = slice.map((p) => ({
  slug: p.slug,
  data: {
    title: p.data.title,
    description: p.data.description || '',
    date: (p.data.date as Date).toISOString(),
    tags: p.data.tags || [],
    category: p.data.category || '',
    cover: p.data.cover || '',
    coverSide: (p.data as any).coverSide || 'left'
  }
}))

const postsCount = total
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) {
  ;(p.data.tags || []).forEach((t) => {
    tagSet.add(t)
    tagCount.set(t, (tagCount.get(t) || 0) + 1)
  })
}
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: '苏晓晴', description: '落花如泪，寄托相思情长。', avatar: 'https://q2.qlogo.cn/headimg_dl?dst_uin=3074193836&spec=640' }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title }))

---
<BaseLayout title="博客主页">
  <div class="page-grid">
    <div id="home-hero" class="hero-card">
      <img class="hero-img" src="https://eopfapi.b.2.f.f.0.7.4.0.1.0.0.2.ip6.arpa/pic?img=ua" alt="首页头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <img class="hero-avatar" src={profile.avatar} alt="avatar" />
        <div class="hero-title">苏晓晴博客</div>
        <div class="hero-desc">落花如泪，寄托相思情长。</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} />
    <div id="pjax-container">
      <h1 style="margin-top:0;">博客文章</h1>
      <TagFilter client:only="vue" posts={clientPosts} />
      <div style="margin-top:20px; display:flex; justify-content:center;">
        <PaginationNav client:only="vue" current={1} pageSize={PAGE_SIZE} total={total} basePath="/page" />
      </div>
    </div>
  </div>
  <style>
    .page-grid { display:grid; gap:24px; align-items:start; grid-template-columns: 360px minmax(0,1fr); }
    .hero-card { position: relative; border-radius: 24px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 8px 24px rgba(0,0,0,.06); background: #fff; grid-column: 1 / -1; }
    .hero-img { width: 100%; height: 300px; object-fit: cover; display: block; }
    .hero-overlay { position: absolute; inset: 0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 24px; background:
      linear-gradient(to top, rgba(0,0,0,.35), rgba(0,0,0,0)),
      linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,0));
      color: #fff; text-align:center; }
    .hero-title { font-size: 28px; font-weight: 800; }
    .hero-desc { font-size: 14px; margin-top: 6px; opacity: .92; }
    .hero-avatar { width: 84px; height: 84px; border-radius: 50%; border: 3px solid rgba(255,255,255,.85); box-shadow: 0 6px 16px rgba(0,0,0,.25); margin-bottom: 12px; }
    @media (max-width: 900px) {
      .page-grid { grid-template-columns: 1fr; }
      .hero-img { height: 220px; }
      .hero-title { font-size: 22px; }
      .hero-desc { font-size: 13px; }
      .hero-avatar { width: 72px; height: 72px; }
    }
  </style>
</BaseLayout>
