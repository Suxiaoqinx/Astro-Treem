---
import BaseLayout from '@layouts/BaseLayout.astro'
import TagFilter from '@components/TagFilter.vue'
import PaginationNav from '@components/PaginationNav.vue'
import SidebarCard from '@components/SidebarCard.vue'
import { getCollection } from 'astro:content'

const PAGE_SIZE = 9
const all = await getCollection('posts')
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const total = all.length
const slice = all.slice(0, PAGE_SIZE)
const clientPosts = slice.map((p) => ({
  slug: p.slug,
  data: {
    title: p.data.title,
    description: p.data.description || '',
    date: (p.data.date as Date).toISOString(),
    tags: p.data.tags || [],
    category: p.data.category || '',
    cover: p.data.cover || '',
    coverSide: (p.data as any).coverSide || 'left'
  }
}))

const postsCount = total
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) {
  ;(p.data.tags || []).forEach((t) => {
    tagSet.add(t)
    tagCount.set(t, (tagCount.get(t) || 0) + 1)
  })
}
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: '苏晓晴', description: '落花如泪，寄托相思情长。', avatar: 'https://q2.qlogo.cn/headimg_dl?dst_uin=3074193836&spec=640' }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title }))

---
<BaseLayout title="博客主页">
  <div style="display:grid; gap:24px; align-items:start; grid-template-columns: 360px 1fr;">
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} />
    <div id="pjax-container">
      <h1 style="margin-top:0;">博客文章</h1>
      <TagFilter client:only="vue" posts={clientPosts} />
      <div style="margin-top:20px; display:flex; justify-content:center;">
        <PaginationNav client:only="vue" current={1} pageSize={PAGE_SIZE} total={total} basePath="/page" />
      </div>
    </div>
  </div>
</BaseLayout>
