---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import TagsList from '@components/TagsList.vue'
import SidebarCard from '@components/SidebarCard.vue'

const posts = await getCollection('posts')
posts.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const years = new Map<number, number>()
for (const p of posts) {
  const y = (p.data.date as Date).getFullYear()
  years.set(y, (years.get(y) || 0) + 1)
}
const list = Array.from(years.entries()).sort((a, b) => b[0] - a[0])
const postsCount = posts.length
const tagSet = new Set<string>()
for (const p of posts) { (p.data.tags || []).forEach((t) => tagSet.add(t)) }
const counts = { posts: postsCount, tags: tagSet.size }
const tagCount = new Map<string, number>()
for (const p of posts) { (p.data.tags || []).forEach((t) => tagCount.set(t, (tagCount.get(t) || 0) + 1)) }
const profile = { name: '苏晓晴', description: '落花如泪，寄托相思情长。', avatar: 'https://q2.qlogo.cn/headimg_dl?dst_uin=3074193836&spec=640' }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = posts.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title }))
---
<BaseLayout title="归档">
  <div style="display:grid; gap:24px; align-items:start; grid-template-columns: 360px 1fr;">
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} />
    <div id="pjax-container">
      <h1>归档</h1>
      <TagsList client:only="vue" items={list.map(([y,n]) => ({ name: String(y), count: n }))} basePath="/archives" />
    </div>
  </div>
</BaseLayout>
