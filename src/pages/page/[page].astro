---
import BaseLayout from '@layouts/BaseLayout.astro'
import Hero from '@components/Hero.astro'
import PostList from '@components/PostList.vue'
import SidebarCard from '@components/SidebarCard.vue'
import PaginationNav from '@components/PaginationNav.vue'
import HeroDescription from '@components/HeroDescription.vue'
import { getCollection } from 'astro:content'
import { siteConfig } from 'src/site.config'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const total = posts.length
  const PAGE_SIZE = siteConfig.pageSize
  const pages = Math.max(1, Math.ceil(total / PAGE_SIZE))
  return Array.from({ length: pages }, (_, i) => ({ params: { page: String(i + 1) } }))
}

const { page } = Astro.params
const PAGE_SIZE = siteConfig.pageSize
const current = Math.max(1, Number(page))

const all = await getCollection('posts')
// sort by date desc
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())

const total = all.length
const start = (current - 1) * PAGE_SIZE
const slice = all.slice(start, start + PAGE_SIZE)

const clientPosts = slice.map((p) => ({
  title: p.data.title,
  description: p.data.description || '',
  date: (p.data.date as Date).toISOString(),
  tags: p.data.tags || [],
  slug: p.slug,
  cover: p.data.cover || '',
  side: (p.data as any).coverSide || 'left',
  showCover: true,
  top: (p.data as any).top === true
}))

const postsCount = total
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) {
  ;(p.data.tags || []).forEach((t) => {
    tagSet.add(t)
    tagCount.set(t, (tagCount.get(t) || 0) + 1)
  })
}
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,50).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,50).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice
---
<BaseLayout title="博客">
  <div class="page-grid">
    <Hero profile={profile}>
      <HeroDescription client:load defaultText={siteConfig.hero.description} />
    </Hero>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} notice={notice} />
    <div id="pjax-container">
      <div class="fade-up">
        <PostList client:only="vue" posts={clientPosts} />
      </div>
      <PaginationNav client:visible current={current} pageSize={PAGE_SIZE} total={total} basePath="/page" />
    </div>
  </div>
</BaseLayout>
