---
import BaseLayout from '@layouts/BaseLayout.astro'
import SidebarCard from '@components/SidebarCard.vue'
import ThemeSwitcher from '@components/ThemeSwitcher.vue'
import { getCollection, getEntry } from 'astro:content'
import { siteConfig } from 'src/site.config'
import talks from 'src/data/talks.json'
const entry = await getEntry('pages', 'talks')
const { Content } = await entry.render()

const all = await getCollection('posts')
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const postsCount = all.length
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) { (p.data.tags || []).forEach((t) => { tagSet.add(t); tagCount.set(t, (tagCount.get(t) || 0) + 1) }) }
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,50).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,50).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice

const list = [...talks].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
---
<BaseLayout title={entry.data.title}>
  <div class="page-grid">
    <div id="home-hero" class="hero-card fade-up">
      <img class="hero-img" src={siteConfig.hero.bg} alt="头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <div class="hero-title">{entry.data.title}</div>
        <div class="hero-desc">{entry.data.description || ''}</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} notice={notice} />
    <ThemeSwitcher client:only="vue" />
    <article id="pjax-container" class="post">
      <div class="talks-list fade-up">
        {list.map((t) => (
          <div class="talk-card">
            <div class="talk-meta">{new Date(t.date).toLocaleString()}</div>
            <div class="talk-content">{t.content}</div>
            {Array.isArray(t.images) && t.images.length ? (
              <div class="talk-images">
                {t.images.map((src) => (<img src={src} alt="" loading="lazy" />))}
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>
