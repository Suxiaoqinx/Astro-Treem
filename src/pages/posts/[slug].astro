---
import BaseLayout from '@layouts/BaseLayout.astro'
import SidebarCard from '@components/SidebarCard.vue'
import DonateButtons from '@components/DonateButtons.vue'
import WalineComments from '@components/WalineComments.vue'
import { getEntry, getCollection } from 'astro:content'
import { siteConfig } from 'src/site.config'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const entry = await getEntry('posts', slug as string)

if (!entry) {
  throw new Error(`Post not found: ${slug}`)
}

const { Content, headings } = await entry.render()
const all = await getCollection('posts')
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const index = all.findIndex((p) => p.slug === slug)
const prev = index > 0 ? all[index - 1] : undefined
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined

// sidebar data
const postsCount = all.length
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) {
  ;(p.data.tags || []).forEach((t) => {
    tagSet.add(t)
    tagCount.set(t, (tagCount.get(t) || 0) + 1)
  })
}
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice

const raw = entry.body || ''
const plain = raw
  .replace(/```[\s\S]*?```/g, '')
  .replace(/!\[[^\]]*\]\([^\)]+\)/g, '')
  .replace(/\[[^\]]*\]\([^\)]+\)/g, '')
  .replace(/[#>*`_~\-]/g, '')
  .replace(/\s+/g, '')
const han = (plain.match(/\p{Script=Han}/gu) || []).length
const words = (plain.match(/\p{L}+/gu) || []).length
const wordCount = Math.max(han + words, plain.length)
const readMinutes = Math.max(1, Math.round(wordCount / 500))
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page-grid">
    <div id="home-hero" class="hero-card fade-up">
      <img class="hero-img" src={siteConfig.hero.bg} alt="头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <img class="hero-avatar" src={profile.avatar} alt="avatar" />
        <div class="hero-title">{siteConfig.hero.title}</div>
        <div class="hero-desc">{siteConfig.hero.description}</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} headings={headings} notice={notice} />
    <article id="pjax-container" class="post fade-up">
      <div class="post-header">
        <div class="post-title-box">
          <h1 class="post-title">{entry.data.title}</h1>
          <div class="post-submeta">{new Date(entry.data.date as Date).toLocaleDateString()} · {wordCount} 字 · 预计阅读 {readMinutes} 分钟</div>
        </div>
      </div>

      <div class="post-content-card">
        <div class="prose">
          <Content />
        </div>
        <div class="donate-card">
          <div class="donate-text">喜欢这篇文章噢，觉得不错的话，奖励奖励我！</div>
          <DonateButtons client:only="vue" />
        </div>
        <div id="donate-overlay" class="donate-overlay" style="display:none;">
          <div class="donate-backdrop"></div>
          <div class="donate-modal">
            <div class="donate-modal-title" id="donate-title">推荐使用支付宝</div>
            <img id="donate-qr" alt="二维码" referrerpolicy="no-referrer" />
            <button id="donate-close" class="donate-close" aria-label="关闭">×</button>
          </div>
        </div>
      <div class="meta-card meta-dark">
        <a class="meta-title" href={`/posts/${slug}`}>{entry.data.title}</a>
        <a class="meta-url" id="article-url" href={`/posts/${slug}`} rel="noopener">{`/posts/${slug}`}</a>
        <div class="meta-grid">
          <div class="meta-item">
            <div class="meta-label">作者</div>
            <div class="meta-value">{profile.name}</div>
          </div>
          <div class="meta-item">
            <div class="meta-label">发布于</div>
            <div class="meta-value">{new Date(entry.data.date as Date).toISOString().slice(0,10)}</div>
          </div>
          <div class="meta-item">
            <div class="meta-label">许可协议</div>
            <div class="meta-value"><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a></div>
          </div>
        </div>
      </div>
      <hr />
      <div class="post-nav">
          {prev ? (<a href={`/posts/${prev.slug}`}>← 上一篇：{prev.data.title}</a>) : (<span />)}
          {next ? (<a href={`/posts/${next.slug}`}>下一篇：{next.data.title} →</a>) : (<span />)}
      </div>
      {entry.data.comment !== false ? (<WalineComments client:only="vue" />) : null}
    </div>
    <style>
    .page-grid { display:grid; gap:20px; align-items:start; grid-template-columns: 360px minmax(0, 1fr); }
    .post { width: 100%; margin: 0; justify-self: stretch; }
    .post-header { display:flex; flex-direction:column; gap:18px; }
    .post-title-box { background:#fff; border:1px solid #e5e7eb; border-radius:24px; padding:24px 28px; }
    .post-title { font-size: 34px; font-weight: 800; margin: 0; letter-spacing: .2px; }
    .post-submeta { color:#666; font-size:14px; margin-top:10px; }
    .post-content-card { background:#fff; border:1px solid #e5e7eb; border-radius:24px; padding:26px 28px; margin-top:18px; overflow:hidden; box-shadow: 0 8px 24px rgba(0,0,0,.06); min-height:560px; display:flex; flex-direction:column; }
    .prose { color:#1f2937; font-size:17px; line-height:1.9; width:100%; flex: 1 1 auto; }
    .prose :global(p) { margin: 1.1em 0; }
    .prose :global(h2) { font-size: 26px; margin: 1.4em 0 .7em; font-weight: 800; color:#111827; }
    .prose :global(h3) { font-size: 22px; margin: 1.2em 0 .6em; font-weight: 700; color:#111827; }
    .prose :global(h4) { font-size: 18px; margin: 1em 0 .5em; font-weight: 700; color:#111827; }
    .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top: 80px; }
    .prose :global(a) { color:#409eff; text-decoration:underline; text-decoration-thickness: 2px; text-underline-offset: 2px; }
    .prose :global(a:hover) { color:#1d4ed8; }
    .post-content-card .prose img { max-width: 100%; height: auto; display: block; margin: 14px auto; border-radius: 16px; padding: 8px; background: #fff; border: 1px solid #eee; box-shadow: 0 3px 10px rgba(0,0,0,.06); box-sizing: border-box; cursor: zoom-in; }
    .prose :global(pre) { background:#0b1220; color:#e5eaf3; padding: 16px 18px; border-radius: 14px; overflow: auto; font-size:14px; line-height:1.6; tab-size: 2; }
    .prose :global(code) { background:#f2f6fc; color:#1f2d3d; padding: 2px 6px; border-radius: 6px; }
    .prose :global(pre code) { background: transparent; padding: 0; color: inherit; }
    .prose :global(blockquote) { border-left: 4px solid #409eff; background: #f5f7fa; padding: 12px 16px; border-radius: 10px; color: #4b5563; }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin: .9em 0; }
    .prose :global(li) { margin: .35em 0; }
    .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0; }
    .prose :global(th), .prose :global(td) { border: 1px solid #eee; padding: 10px 12px; }
    .prose :global(th) { background: #fafafa; font-weight: 700; }
    .prose :global(hr) { border: none; border-top: 1px solid #eee; margin: 28px 0; }
    .donate-card { margin: 20px 0 10px; padding: 16px; background:#fff; border:1px solid #e5e7eb; border-radius:18px; box-shadow: 0 8px 24px rgba(0,0,0,.06); text-align:center; }
    .donate-text { color:#6b7280; margin-bottom: 12px; }
    .donate-actions { display:flex; gap:12px; justify-content:center; }
    .meta-card { position: relative; margin: 6px 0 12px; padding: 1.5rem; border:1px solid #e5e7eb; border-radius:18px; }
    .meta-card.meta-dark { background:#fff; border-color:#e5e7eb; color:#000; box-shadow: 0 8px 24px rgba(0,0,0,.06); }
    .meta-card.meta-dark::after { content: 'CC'; position:absolute; right:16px; bottom:10px; font-size:80px; color: rgba(0,0,0,.06); font-weight:800; }
    .meta-title { display:block; font-weight:800; font-size:18px; color:#000 !important; text-decoration:none; }
    .meta-title:hover { color:#000; }
    .meta-url { display:block; margin-top:4px; color:#000; text-decoration:none; }
    .meta-url:hover { text-decoration:underline; }
    .meta-grid { display:grid; grid-template-columns: auto auto auto; column-gap: 12px; row-gap: 0; margin-top:8px; align-items:start; }
    .meta-item { display:flex; flex-direction:column; align-items:flex-start; gap:2px; }
    .meta-label { color:#000; font-size:13px; }
    .meta-value { color:#000; font-size:15px; font-weight:700; }
    .meta-card a { color:#000; }
    .donate-overlay { position: fixed; inset: 0; z-index: 10001; display:flex; align-items:center; justify-content:center; }
    .donate-backdrop { position:absolute; inset:0; background: rgba(0,0,0,.35); }
    .donate-modal { position:relative; z-index:1; width: min(360px, 88vw); border-radius: 18px; background:#fff; box-shadow: 0 16px 40px rgba(0,0,0,.18); border:1px solid #e5e7eb; padding: 16px; text-align:center; }
    .donate-modal-title { font-weight:800; color:#1f2937; margin-bottom: 12px; }
    #donate-qr { width: 260px; height: 260px; border-radius: 12px; display:block; margin: 0 auto; object-fit: contain; background:#f5f7fa; }
    .donate-close { position:absolute; right:10px; top:10px; width:28px; height:28px; border:none; background:#f5f7fa; border-radius:8px; cursor:pointer; }
    .post-nav { display:flex; justify-content:space-between; margin-top:auto; }
    .post-nav a { color:#374151; text-decoration:none; }
    .post-nav a:hover { color:#111827; text-decoration:underline; }
    .img-error { border-color:#ddd; border-style:dashed; }
    @media (max-width: 900px) {
      .page-grid { grid-template-columns: minmax(0, 1fr); }
      .post { max-width: 100%; }
    }
    @media (max-width: 640px) {
      .post-title { font-size: 24px; }
      .post-title-box { padding: 20px; }
      .post-content-card { padding: 16px; border-radius: 20px; min-height: auto; }
      .prose { font-size: 16px; line-height: 1.75; }
      .meta-grid { grid-template-columns: 1fr; gap: 12px; }
      .meta-item { flex-direction: row; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px dashed #eee; padding-bottom: 8px; }
      .meta-item:last-child { border-bottom: none; padding-bottom: 0; }
      .post-nav { flex-direction: column; gap: 12px; }
      .post-nav a { display: block; background: #f9fafb; padding: 12px; border-radius: 12px; border: 1px solid #eee; text-align: center; font-size: 14px; }
      .meta-card { padding: 16px; }
      .meta-card::after { font-size: 60px; right: 10px; bottom: 10px; opacity: 0.5; }
      .prose :global(table) { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    }
    </style>
    <style>
      .hero-card { position: relative; border-radius: 24px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 8px 24px rgba(0,0,0,.06); background: #fff; grid-column: 1 / -1; }
      .hero-img { width: 100%; height: 300px; object-fit: cover; display: block; }
      .hero-overlay { position: absolute; inset: 0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 24px; background:
        linear-gradient(to top, rgba(0,0,0,.35), rgba(0,0,0,0)),
        linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,0));
        color: #fff; text-align:center; }
      .hero-avatar { width: 84px; height: 84px; border-radius: 50%; border: 3px solid rgba(255,255,255,.85); box-shadow: 0 6px 16px rgba(0,0,0,.25); margin-bottom: 12px; }
      .hero-title { font-size: 28px; font-weight: 800; }
      .hero-desc { font-size: 14px; margin-top: 6px; opacity: .92; }
      @media (max-width: 900px) { .hero-img { height: 220px; } .hero-title { font-size: 22px; } .hero-desc { font-size: 13px; } .hero-avatar { width: 72px; height: 72px; } }
    </style>
    <style is:global>
    .post-content-card .prose img,
    .post-content-card .prose img.posts-img,
    .post-content-card .prose picture img,
    .post-content-card .prose figure img {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 14px auto;
      border-radius: 16px;
      padding: 8px;
      background: #fff;
      border: 1px solid #eee;
      box-shadow: 0 3px 10px rgba(0,0,0,.06);
      box-sizing: border-box;
    }
    .post-content-card .prose { overflow-wrap: anywhere; }
    .post-content-card .prose table { max-width: 100%; }
    </style>
    </article>
  </div>
</BaseLayout>
