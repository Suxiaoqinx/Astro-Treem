---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import SidebarCard from '@components/SidebarCard.vue'
import TagsList from '@components/TagsList.vue'
import { siteConfig } from 'src/site.config'
// import TagFilter from '@components/TagFilter.vue'

const posts = await getCollection('posts')
posts.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())

const postsCount = posts.length
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of posts) { (p.data.tags || []).forEach((t) => { tagSet.add(t); tagCount.set(t, (tagCount.get(t) || 0) + 1) }) }
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = posts.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice

// const clientPosts = posts.map((p) => ({
//   slug: p.slug,
//   data: {
//     title: p.data.title,
//     description: p.data.description || '',
//     date: (p.data.date as Date).toISOString(),
//     tags: p.data.tags || [],
//     category: p.data.category || '',
//     cover: p.data.cover || '',
//     coverSide: p.data.coverSide || 'left'
//   }
// }))
const allTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).map(([name,count]) => ({ name, count }))
---
<BaseLayout title="标签">
  <div class="page-grid">
    <div id="home-hero" class="hero-card">
      <img class="hero-img" src={siteConfig.hero.bg} alt="头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <div class="hero-title">标签</div>
        <div class="hero-desc">按标签浏览内容</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} notice={notice} />
    <article id="pjax-container" class="post">
      <div class="post-header">
        <div class="post-title-box">
          <h1 class="post-title">标签</h1>
          <div class="post-submeta">共 {counts.tags} 个标签 · {counts.posts} 篇文章</div>
        </div>
      </div>
      <div class="post-content-card">
        <div class="prose">
          <TagsList client:only="vue" items={allTags} basePath="/tags" />
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
