---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import TimelineList from '@components/TimelineList.vue'
import SidebarCard from '@components/SidebarCard.vue'
import { siteConfig } from 'src/site.config'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const tags = new Set()
  for (const p of posts) (p.data.tags || []).forEach((t) => tags.add(t))
  return Array.from(tags).map((t) => ({ params: { tag: t } }))
}

const { tag } = Astro.params
const all = await getCollection('posts')
all.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const filtered = all.filter((p) => (p.data.tags || []).includes(tag as string))
filtered.sort((a, b) => (b.data.date as Date).getTime() - (a.data.date as Date).getTime())
const clientPosts = filtered.map((p) => ({
  slug: p.slug,
  data: {
    title: p.data.title,
    description: p.data.description || '',
    date: (p.data.date as Date).toISOString(),
    tags: p.data.tags || [],
    category: p.data.category || ''
  }
}))
const postsCount = all.length
const tagSet = new Set<string>()
const tagCount = new Map<string, number>()
for (const p of all) { (p.data.tags || []).forEach((t) => { tagSet.add(t); tagCount.set(t, (tagCount.get(t) || 0) + 1) }) }
const counts = { posts: postsCount, tags: tagSet.size }
const profile = { name: siteConfig.author, description: siteConfig.description, avatar: siteConfig.avatar }
const hotTags = Array.from(tagCount.entries()).sort((a,b) => b[1]-a[1]).slice(0,10).map(([name,count]) => ({ name, count }))
const recommendations = all.slice(0,5).map((p) => ({ slug: p.slug, title: p.data.title, date: (p.data.date as Date).toISOString() }))
const notice = siteConfig.notice
---
<BaseLayout title={`标签：${tag}`}>
  <div class="page-grid">
    <div id="home-hero" class="hero-card">
      <img class="hero-img" src={siteConfig.hero.bg} alt="头图" referrerpolicy="no-referrer" />
      <div class="hero-overlay">
        <div class="hero-title">标签：{tag}</div>
        <div class="hero-desc">按标签浏览内容</div>
      </div>
    </div>
    <SidebarCard client:only="vue" name={profile.name} description={profile.description} avatar={profile.avatar} counts={counts} hotTags={hotTags} recommendations={recommendations} notice={notice} />
    <article id="pjax-container" class="post">
      <div class="post-header">
        <div class="post-title-box">
          <h1 class="post-title">标签：{tag}</h1>
          <div class="post-submeta">共 {clientPosts.length} 篇</div>
        </div>
      </div>
      <div class="post-content-card">
        <div class="prose">
          <TimelineList client:only="vue" posts={clientPosts} />
        </div>
      </div>
    </article>
  </div>
  <style>
    .page-grid { display:grid; gap:24px; align-items:start; grid-template-columns: 360px minmax(0,1fr); }
    .hero-card { position: relative; border-radius: 24px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 8px 24px rgba(0,0,0,.06); background: #fff; grid-column: 1 / -1; }
    .hero-img { width: 100%; height: 300px; object-fit: cover; display: block; }
    .hero-overlay { position: absolute; inset: 0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 24px; background:
      linear-gradient(to top, rgba(0,0,0,.35), rgba(0,0,0,0)),
      linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,0));
      color: #fff; text-align:center; }
    .hero-title { font-size: 28px; font-weight: 800; }
    .hero-desc { font-size: 14px; margin-top: 6px; opacity: .92; }
    .post { width: 100%; margin: 0; justify-self: stretch; }
    .post-header { display:flex; flex-direction:column; gap:18px; }
    .post-title-box { background:#fff; border:1px solid #e5e7eb; border-radius:24px; padding:24px 28px; }
    .post-title { font-size: 34px; font-weight: 800; margin: 0; letter-spacing: .2px; }
    .post-submeta { color:#666; font-size:14px; margin-top:10px; }
    .post-content-card { background:#fff; border:1px solid #e5e7eb; border-radius:24px; padding:22px 24px 22px 16px; margin-top:18px; overflow:hidden; box-shadow: 0 8px 24px rgba(0,0,0,.06); min-height:260px; display:flex; flex-direction:column; }
    .prose { color:#1f2937; font-size:17px; line-height:1.9; width:100%; }
    .prose :global(.el-timeline) { margin-left: 0; padding-left: 0; }
    .prose :global(.el-timeline-item) { margin-left: 0; }
    @media (max-width: 900px) {
      .page-grid { grid-template-columns: 1fr; }
      .hero-img { height: 220px; }
      .hero-title { font-size: 22px; }
      .hero-desc { font-size: 13px; }
    }
  </style>
</BaseLayout>
