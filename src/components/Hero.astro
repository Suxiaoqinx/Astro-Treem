---
import { siteConfig } from 'src/site.config'
const { profile, title = siteConfig.hero.title, bg = siteConfig.hero.bg } = Astro.props
---

<div id="home-hero" class="hero-card fade-up">
  <img class="hero-img" src={bg} alt="头图" referrerpolicy="no-referrer" />
  <div class="hero-overlay">
    {profile && <img class="hero-avatar" src={profile.avatar} alt="avatar" />}
    <div class="hero-title">{title}</div>
    <slot />
  </div>
</div>
