---
import 'element-plus/dist/index.css'
import { getCollection } from 'astro:content'
import HeaderMenu from '@components/HeaderMenu.vue'
const { title = 'Astro Treem Blog', description = 'Astro + Element Plus 博客框架' } = Astro.props
const all = await getCollection('posts')
const searchIndex = all.map((p) => ({ slug: p.slug, title: p.data.title || '', description: p.data.description || '', tags: p.data.tags || [] }))
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/viewerjs@1.11.6/dist/viewer.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/viewerjs@1.11.6/dist/viewer.min.js"></script>
  </head>
  <body style="min-height:100vh; display:flex; flex-direction:column; margin:0;">
    <header style="border-bottom:1px solid #eee;">
      <div style="max-width:85rem; margin:0 auto; padding:16px; display:flex; align-items:center; gap:16px;">
        <a href="/" data-ajax="post" class="home-button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 11l9-7 9 7v7a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-7Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 15c.8 1 2.2 1 3 0" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Home</span>
        </a>
        <HeaderMenu client:only="vue" />
      </div>
    </header>
    <main style="flex:1 0 auto; padding:24px; max-width:85rem; margin:0 auto; width:100%; box-sizing:border-box;">
      <slot />
    </main>
    <footer style="padding:24px; border-top:1px solid #eee; text-align:center; color:#666;">
      <div class="footer-badges">
        <span class="badge purple"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M7 4h10v4H7zM4 10h16v10H4z" stroke="#7e57c2" stroke-width="2"/></svg>Frame</span>
        <span class="badge purple">Astro</span>
        <a href="/sitemap-index.xml" class="badge orange" style="text-decoration:none;" target="_blank"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6h12v4H6zM6 14h12v4H6z" stroke="#e67e22" stroke-width="2"/></svg>Sitemap</a>
        <a href="/rss.xml" data-ajax="post" class="badge orange" style="text-decoration:none;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="6" cy="18" r="2" fill="#e67e22"/><path d="M4 4c8 0 16 8 16 16" stroke="#e67e22" stroke-width="2"/><path d="M4 10c5 0 10 5 10 10" stroke="#e67e22" stroke-width="2"/></svg>RSS订阅</a>
        <span class="badge gray">桂ICP备2022007996号-1</span>
      </div>
      <div style="margin-top:10px;">© 2020 - {new Date().getFullYear()} 苏晓晴博客</div>
    </footer>
    <script type="application/json" id="search-index">{JSON.stringify(searchIndex).replace(/</g, '\\u003c')}</script>
    <div id="search-overlay" style="position:fixed; inset:0; z-index:10000; display:none;">
      <div id="search-backdrop" style="position:absolute; inset:0; background:rgba(0,0,0,.18);"></div>
      <div style="position:absolute; left:50%; top:12%; transform:translateX(-50%); width: min(720px, 92vw); background:#fff; border:1px solid #e5e7eb; border-radius:16px; box-shadow:0 16px 40px rgba(0,0,0,.12); overflow:hidden;">
        <div style="display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid #f2f2f2;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm9-1-4.35-4.35" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input id="nav-search-input" type="text" placeholder="搜索文章标题、标签或描述" style="flex:1; padding:10px 12px; border:1px solid #e5e7eb; border-radius:10px; outline:none;" />
          <button id="search-close" style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border:none; background:transparent; cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6l12 12M18 6L6 18" stroke="#777" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div id="nav-search-list" style="max-height:52vh; overflow:auto;">
        </div>
        <div id="nav-search-empty" style="display:none; padding:24px; text-align:center; color:#777; font-size:14px;">无搜索结果</div>
    </div>
    </div>
    <div id="viewer-progress" style="position:fixed; left:50%; bottom:18px; transform:translateX(-50%); width:min(60vw, 520px); height:4px; background:rgba(255,255,255,.35); border-radius:999px; overflow:hidden; display:none; z-index:10002;">
      <div id="viewer-progress-bar" style="height:100%; width:0; background:#409eff;"></div>
    </div>
    <script type="module" is:inline>
      const CONTAINER_ID = 'pjax-container'
      let VIEWER_INSTANCE = null
      let VIEW_TIMER = 0
      function startProgress(){
        const wrap = document.getElementById('viewer-progress')
        const bar = document.getElementById('viewer-progress-bar')
        if (!wrap || !(bar instanceof HTMLElement)) return
        wrap.style.display = 'block'
        bar.style.width = '0%'
        if (VIEW_TIMER) window.clearInterval(VIEW_TIMER)
        let w = 0
        VIEW_TIMER = window.setInterval(() => { w = Math.min(90, w + 2); bar.style.width = w + '%'}, 60)
      }
      function endProgress(){
        const wrap = document.getElementById('viewer-progress')
        const bar = document.getElementById('viewer-progress-bar')
        if (!wrap || !(bar instanceof HTMLElement)) return
        if (VIEW_TIMER) { window.clearInterval(VIEW_TIMER); VIEW_TIMER = 0 }
        bar.style.width = '100%'
        setTimeout(() => { wrap.style.display = 'none'; bar.style.width = '0%' }, 250)
      }
      function setupViewer(){
        const root = document.querySelector('#'+CONTAINER_ID+' .post-content-card .prose')
        if (!root || !(window && window.Viewer)) return
        if (VIEWER_INSTANCE && typeof VIEWER_INSTANCE.destroy === 'function') {
          try { VIEWER_INSTANCE.destroy() } catch {}
          VIEWER_INSTANCE = null
        }
        VIEWER_INSTANCE = new window.Viewer(root, {
          navbar: false,
          title: false,
          toolbar: { zoomIn: 1, zoomOut: 1, reset: 1, prev: 1, next: 1 },
          tooltip: false,
          movable: true,
          transition: true,
          backdrop: true,
          view() { startProgress() },
          viewed() { endProgress() },
        })
      }
      
      function enhancePostImages(){
        const root = document.querySelector('#'+CONTAINER_ID+' .post-content-card .prose')
        if (!root) return
        const imgs = Array.from(root.querySelectorAll('img'))
        for (const img of imgs){
          img.setAttribute('class','posts-img')
          img.setAttribute('loading','lazy')
          img.setAttribute('decoding','async')
          img.setAttribute('referrerpolicy','no-referrer')
          img.style.cursor = 'zoom-in'
          img.addEventListener('error', function(){
            const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='800' height='480'><rect width='100%' height='100%' fill='#f5f7fa'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='#999' font-family='system-ui' font-size='16'>图片加载失败</text></svg>"
            this.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
            this.classList.add('img-error')
          }, { once: true })
        }
      }
      function setupDonateOverlay(){
        const overlay = document.querySelector('#'+CONTAINER_ID+' #donate-overlay')
        const title = document.querySelector('#'+CONTAINER_ID+' #donate-title')
        const img = document.querySelector('#'+CONTAINER_ID+' #donate-qr')
        const closeBtn = document.querySelector('#'+CONTAINER_ID+' #donate-close')
        const backdrop = overlay ? overlay.querySelector('.donate-backdrop') : null
        function show(type){
          if (!(overlay instanceof HTMLElement) || !(title instanceof HTMLElement) || !(img instanceof HTMLImageElement)) return
          title.textContent = type === 'wechat' ? '推荐使用微信' : '推荐使用支付宝'
          const src = type === 'wechat' ? '/assets/donate/wechat.png' : '/assets/donate/alipay.png'
          img.src = src
          img.onerror = function(){
            const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='520'><rect width='100%' height='100%' rx='16' fill='" + (type==='wechat'?'#10b981':'#409eff') + "'/><text x='50%' y='14%' dominant-baseline='middle' text-anchor='middle' fill='#fff' font-family='system-ui' font-size='22'>推荐使用" + (type==='wechat'?'微信':'支付宝') + "</text><rect x='110' y='110' width='300' height='300' rx='12' fill='#f5f7fa' stroke='#e5e7eb'/><text x='50%' y='88%' dominant-baseline='middle' text-anchor='middle' fill='#fff' font-family='system-ui' font-size='16'>请前往捐赠页面查看二维码</text></svg>"
            img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
          }
          overlay.style.display = 'flex'
          document.body.style.overflow = 'hidden'
        }
        function hide(){ if (!(overlay instanceof HTMLElement)) return; overlay.style.display = 'none'; document.body.style.overflow = '' }
        const btns = Array.from(document.querySelectorAll('#'+CONTAINER_ID+' .donate-card [data-donate]'))
        for (const b of btns){ b.addEventListener('click', (e) => { e.preventDefault(); show(b.getAttribute('data-donate')||'') }) }
        if (closeBtn) closeBtn.addEventListener('click', () => hide())
        if (backdrop) backdrop.addEventListener('click', () => hide())
        const a = document.querySelector('#'+CONTAINER_ID+' #article-url')
        if (a && a instanceof HTMLAnchorElement) { a.textContent = window.location.href; a.href = window.location.href }
      }
      function runFragmentScripts(){
        const root = document.getElementById(CONTAINER_ID)
        if (!root) return
        const scripts = Array.from(root.querySelectorAll('script'))
        for (const s of scripts){
          if (s.src) {
            const exists = Array.from(document.head.querySelectorAll('script')).some((x) => x.src === s.src)
            if (exists) continue
            const copy = document.createElement('script')
            for (const {name,value} of Array.from(s.attributes)) copy.setAttribute(name, value)
            copy.removeAttribute('data-astro-cid')
            copy.setAttribute('data-ajax-managed','1')
            copy.src = s.src
            document.head.appendChild(copy)
          }
        }
        const prev = Array.from(document.head.querySelectorAll('style[data-ajax-style]'))
        for (const p of prev) p.parentNode && p.parentNode.removeChild(p)
        const styles = Array.from(root.querySelectorAll('style'))
        for (const st of styles){
          const clone = document.createElement('style')
          clone.setAttribute('data-ajax-style','1')
          clone.textContent = st.textContent || ''
          document.head.appendChild(clone)
        }
      }
      function emitSidebarHeadings(){
        const container = document.getElementById(CONTAINER_ID)
        if (!container) return
        const prose = container.querySelector('.prose')
        const hs = []
        if (prose) {
          const nodes = Array.from(prose.querySelectorAll('h2,h3,h4'))
          nodes.forEach((el, i) => {
            const tag = (el.tagName || 'H2').toLowerCase()
            const depth = tag === 'h2' ? 2 : tag === 'h3' ? 3 : 4
            const text = el.textContent || ''
            let slug = el.getAttribute('id') || (text.trim().toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9\-]/g,''))
            if (!slug) slug = `toc-${i}`
            if (!el.getAttribute('id')) el.setAttribute('id', slug)
            hs.push({ slug, text, depth })
          })
        }
        try { document.dispatchEvent(new CustomEvent('ajax:updateSidebar', { detail: { headings: hs } })) } catch {}
      }
      function syncHeadAssets(doc){
        const newLinks = Array.from(doc.querySelectorAll('head link[rel="stylesheet"]'))
        const newHrefs = new Set(newLinks.map((l) => l.getAttribute('href') || '').filter((x) => !!x))
        const managed = Array.from(document.head.querySelectorAll('link[rel="stylesheet"][data-ajax-managed="1"]'))
        for (const m of managed){
          const href = m.getAttribute('href') || ''
          if (!newHrefs.has(href)) m.parentNode && m.parentNode.removeChild(m)
        }
        const currentHrefs = new Set(
          Array.from(document.head.querySelectorAll('link[rel="stylesheet"]'))
            .map((l) => l.getAttribute('href') || '')
            .filter((x) => !!x)
        )
        for (const l of newLinks){
          const href = l.getAttribute('href') || ''
          if (!href) continue
          if (!currentHrefs.has(href)){
            const clone = l.cloneNode(true)
            clone.setAttribute('data-ajax-managed','1')
            document.head.appendChild(clone)
          }
        }
        const prevHeadStyles = Array.from(document.head.querySelectorAll('style[data-ajax-managed="1"]'))
        for (const s of prevHeadStyles) s.parentNode && s.parentNode.removeChild(s)
        const newHeadStyles = Array.from(doc.querySelectorAll('head style'))
        for (const st of newHeadStyles){
          const clone = st.cloneNode(true)
          clone.setAttribute('data-ajax-managed','1')
          document.head.appendChild(clone)
        }
      }
      async function ajaxNavigate(url, replace=false){
        const container = document.getElementById(CONTAINER_ID)
        if (!container) { window.location.href = url; return }
        const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
        const html = await res.text()
        const dom = new DOMParser().parseFromString(html, 'text/html')
        const next = dom.getElementById(CONTAINER_ID)
        const title = dom.querySelector('title')?.textContent || document.title
        if (next){
          syncHeadAssets(dom)
          function syncHomeHero(doc){
            const nextHero = doc.getElementById('home-hero')
            const currentHero = document.getElementById('home-hero')
            const grid = document.querySelector('.page-grid')
            if (nextHero && grid){
              if (currentHero && currentHero.parentNode) currentHero.parentNode.removeChild(currentHero)
              const clone = nextHero.cloneNode(true)
              grid.insertBefore(clone, grid.firstChild)
            } else {
              if (currentHero && currentHero.parentNode) currentHero.parentNode.removeChild(currentHero)
            }
          }
          // sync attributes/classes from target container (e.g., class="post")
          // clear existing non-id attributes
          Array.from(container.attributes).forEach((attr) => {
            if (attr.name !== 'id') container.removeAttribute(attr.name)
          })
          Array.from(next.attributes).forEach((attr) => {
            if (attr.name !== 'id') container.setAttribute(attr.name, attr.value)
          })
          container.innerHTML = next.innerHTML
          document.title = title
          syncHomeHero(dom)
          runFragmentScripts()
          try { document.dispatchEvent(new Event('astro:page-load')) } catch {}
          enhancePostImages()
          setupDonateOverlay()
          emitSidebarHeadings()
          setupViewer()
          try { document.dispatchEvent(new CustomEvent('ajax:afterNavigate', { detail: { url, container } })) } catch {}
          if (!replace) history.pushState({}, '', url)
          window.scrollTo({ top: 0, behavior: 'smooth' })
        } else {
          window.location.href = url
        }
      }
      function isSameOrigin(url){
        try { return new URL(url, window.location.href).origin === window.location.origin } catch { return false }
      }
      document.addEventListener('click', (e) => {
        const t = e.target
        if (!(t instanceof Element)) return
        const a = t.closest('a')
        if (!a) return
        if (!a.matches('[data-ajax="post"]')) return
        const href = a.getAttribute('href') || ''
        if (!href || !isSameOrigin(href)) return
        if (a.target === '_blank') return
        const ev = e
        if ((ev && (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey))) return
        const u = new URL(href, window.location.href)
        if (u.pathname === window.location.pathname && u.search === window.location.search && u.hash) return
        e.preventDefault()
        ajaxNavigate(href)
      }, true)
      window.addEventListener('popstate', () => ajaxNavigate(window.location.href, true))
      window.ajaxNavigate = ajaxNavigate
      try { document.addEventListener('astro:page-load', () => emitSidebarHeadings()) } catch {}
      setTimeout(() => { emitSidebarHeadings(); enhancePostImages(); setupViewer(); setupDonateOverlay() }, 0)
    </script>
    <style is:global>
      #pjax-container img { max-width: 100%; height: auto; }
      #pjax-container .post-content-card .prose img { cursor: zoom-in; }
      .home-button { display:inline-flex; align-items:center; gap:8px; background:#10b981; color:#fff; text-decoration:none; border:none; border-radius:12px; height:36px; padding:0 12px; font-weight:700; }
      .home-button:hover { background:#0ea5a9; }
      .home-button svg { flex:0 0 auto; }
      #pjax-container .page-grid { display: grid; align-items: start; }
      #pjax-container .post { width: 100%; margin: 0; justify-self: stretch; }
      #pjax-container .post-title { font-weight: 800; }
      #pjax-container .post-content-card { background:#fff; border:1px solid #e5e7eb; border-radius:24px; box-shadow: 0 8px 24px rgba(0,0,0,.06); }
      #pjax-container .prose { overflow-wrap: anywhere; }
      footer .footer-badges { display:flex; gap:8px; flex-wrap:wrap; align-items:center; justify-content:center; margin: 4px 0; }
      footer .badge { display:inline-flex; align-items:center; gap:6px; font-size:12px; padding:6px 10px; border-radius:12px; border:1px solid #e5e7eb; box-shadow:0 1px 3px rgba(0,0,0,.06); }
      footer .badge.gray { background:#f5f7fa; color:#444; }
      footer .badge.dark { background:#2f3640; color:#fff; border-color: transparent; }
      footer .badge.green { background:#e6f7f0; color:#14b66f; border-color:#cdeee0; }
      footer .badge.orange { background:#fff3e0; color:#e67e22; border-color:#ffe1ba; }
      footer .badge.purple { background:#f3e9ff; color:#7e57c2; border-color:#e6d3ff; }
      .menu-panel { position:absolute; left:0; top:0; bottom:0; width:min(82vw, 320px); background:#fff; border-right:1px solid #e5e7eb; box-shadow: 0 16px 40px rgba(0,0,0,.12); padding:16px; display:flex; flex-direction:column; gap:12px; }
      .menu-group-card { margin-top:8px; }
      .menu-link { display:flex; align-items:center; gap:10px; text-decoration:none; color: inherit; width:100%; }
      .el-menu-item { height: 40px; line-height: 40px; }
      @media (max-width: 900px) {
        header > div { padding: 12px !important; gap: 10px !important; }
        header nav { gap: 8px !important; }
        header > div > a[href="/"] { font-size: 14px !important; }
        .home-button { height: 32px; padding: 0 10px; }
        #nav-search-button { width: 32px !important; height: 32px !important; }
        .sidebar { display: none !important; }
        #pjax-container .page-grid { grid-template-columns: 1fr; gap: 16px; justify-items: center; }
        #pjax-container .hero-card, #pjax-container .post { width: min(700px, 100%); justify-self: center; }
        #pjax-container .simple-list { max-width: 700px; margin: 0 auto; }
        #home-hero .hero-img { height: 220px; }
        #home-hero .hero-title { font-size: 22px; }
        #home-hero .hero-desc { font-size: 13px; }
        #pjax-container .post-title { font-size: 28px; }
        #pjax-container .post-content-card { padding: 20px; border-radius: 20px; min-height: auto; }
        #pjax-container .prose { font-size: 16px; line-height: 1.85; }
      }
    </style>
    <script type="module" is:inline>
      let INDEX = []
      try {
        const el = document.getElementById('search-index')
        INDEX = el ? JSON.parse(el.textContent || '[]') : []
      } catch {}
      if (!Array.isArray(INDEX) || INDEX.length === 0) {
        try {
          fetch('/search-index.json')
            .then((r) => r.json())
            .then((data) => { if (Array.isArray(data)) INDEX = data })
            .catch(() => {})
        } catch {}
      }
      const btn = document.getElementById('nav-search-button')
      const overlay = document.getElementById('search-overlay')
      const backdrop = document.getElementById('search-backdrop')
      const closeBtn = document.getElementById('search-close')
      const input = document.getElementById('nav-search-input')
      const list = document.getElementById('nav-search-list')
      const empty = document.getElementById('nav-search-empty')
      function openOverlay() {
        if (!overlay) return
        overlay.style.display = 'block'
        document.body.style.overflow = 'hidden'
        setTimeout(() => { input && input.focus() }, 0)
      }
      function closeOverlay() {
        if (!overlay) return
        overlay.style.display = 'none'
        document.body.style.overflow = ''
        if (input) input.value = ''
        if (list) list.innerHTML = ''
        if (empty) empty.style.display = 'none'
      }
      function render(items) {
        if (!list || !empty) return
        if (!items.length) {
          list.innerHTML = ''
          empty.style.display = 'block'
          return
        }
        empty.style.display = 'none'
        list.innerHTML = items.slice(0, 12).map((x) => `<a href="/posts/${x.slug}" data-ajax="post" style="display:block;padding:12px 16px;text-decoration:none;color:#333;border-bottom:1px solid #f2f2f2"><div style="font-weight:600;">${x.title}</div><div style="font-size:12px;color:#666;margin-top:4px;">${(x.tags||[]).join(', ')}</div></a>`).join('')
        const children = Array.from(list.querySelectorAll('a'))
        for (const a of children) {
          a.addEventListener('click', () => { closeOverlay() })
        }
      }
      function search(q) {
        const s = (q || '').trim().toLowerCase()
        if (!s) { list && (list.innerHTML = ''); empty && (empty.style.display = 'none'); return }
        const r = INDEX.filter((x) => x.title.toLowerCase().includes(s) || (x.description||'').toLowerCase().includes(s) || (x.tags||[]).some((t) => (t||'').toLowerCase().includes(s)))
        render(r)
      }
      if (btn) btn.addEventListener('click', () => openOverlay())
      document.addEventListener('click', (e) => {
        const t = e.target
        if (!(t instanceof Element)) return
        const b = t.closest('#nav-search-button') || t.closest('[data-search-trigger="1"]')
        if (b) { e.preventDefault(); openOverlay() }
      })
      if (backdrop) backdrop.addEventListener('click', () => closeOverlay())
      if (closeBtn) closeBtn.addEventListener('click', () => closeOverlay())
      if (input) {
        input.addEventListener('input', () => search(input.value))
        input.addEventListener('keydown', (e) => {
          const v = input.value
          if (e.key === 'Enter') {
            const s = (v||'').trim().toLowerCase()
            const r = INDEX.filter((x) => x.title.toLowerCase().includes(s) || (x.description||'').toLowerCase().includes(s) || (x.tags||[]).some((t) => (t||'').toLowerCase().includes(s)))
            if (r.length) {
              const href = `/posts/${r[0].slug}`
              if (window.ajaxNavigate) window.ajaxNavigate(href)
              else window.location.href = href
              closeOverlay()
            } else {
              empty && (empty.style.display = 'block')
            }
          }
          if (e.key === 'Escape') closeOverlay()
        })
      }
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openOverlay() }
        if (e.key === 'Escape') closeOverlay()
      })
      const menuBtn = document.getElementById('nav-menu-button')
      const menuOverlay = document.getElementById('menu-overlay')
      const menuBackdrop = document.getElementById('menu-backdrop')
      function openMenu(){ if (!menuOverlay) return; menuOverlay.style.display = 'flex'; document.body.style.overflow = 'hidden' }
      function closeMenu(){ if (!menuOverlay) return; menuOverlay.style.display = 'none'; document.body.style.overflow = '' }
      if (menuBtn) {
        ;['click','touchstart'].forEach((ev) => menuBtn.addEventListener(ev, (e) => { e.preventDefault(); openMenu() }))
      }
      if (menuBackdrop) {
        ;['click','touchstart'].forEach((ev) => menuBackdrop.addEventListener(ev, (e) => { e.preventDefault(); closeMenu() }))
      }
      try {
        const links = Array.from(document.querySelectorAll('#menu-overlay .menu-item, #menu-overlay .menu-link'))
        for (const a of links) {
          ;['click','touchstart'].forEach((ev) => a.addEventListener(ev, () => closeMenu()))
        }
      } catch {}
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu() })
    </script>
  </body>
</html>
