---
import 'element-plus/dist/index.css'
import 'src/styles/main.css'
import 'src/styles/switcher.css'
import { getCollection } from 'astro:content'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import BackToTop from '@components/BackToTop.vue'
import ThemeSwitcher from '@components/ThemeSwitcher.vue'
import { siteConfig } from 'src/site.config'

const { title = siteConfig.title, description = siteConfig.description } = Astro.props
const all = await getCollection('posts')
const searchIndex = all.map((p) => ({ slug: p.slug, title: p.data.title || '', description: p.data.description || '', tags: p.data.tags || [] }))
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html'
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={siteConfig.avatar} type="image/svg+xml" />
    <link rel="stylesheet" href="https://unpkg.com/sodesu-comment@0.5.1/dist/sodesu-comment.css" />
    <link rel="stylesheet" href="https://unpkg.com/viewerjs@1.11.6/dist/viewer.min.css" />
    <script src="https://unpkg.com/viewerjs@1.11.6/dist/viewer.min.js" is:inline></script>
    <style>
      /* Swup Transitions */
      #pjax-container, #home-hero {
        transition: opacity 0.3s;
        opacity: 1;
      }
      html.is-animating #pjax-container, html.is-animating #home-hero {
        opacity: 0;
      }
    </style>
  </head>
  <body style="margin:0; min-height:100vh; font-family: system-ui, -apple-system, sans-serif;">
    <div class="common-layout" style="min-height:100vh; display:flex; flex-direction:column;">
      <div class="el-container is-vertical" style="flex:1; display: flex; flex-direction: column;">
        
        <Header />

        <main id="swup" style="flex: 1; width: 100%; max-width: 100rem; margin: 20px auto; padding: 0 20px; box-sizing: border-box;">
            <slot />
        </main>
        
        <Footer />
      </div>
    </div>

    <script type="application/json" id="search-index">{JSON.stringify(searchIndex).replace(/</g, '\\u003c')}</script>
    <div id="search-overlay" style="position:fixed; inset:0; z-index:10000; display:none;">
      <div id="search-backdrop" style="position:absolute; inset:0; background:rgba(0,0,0,.18);"></div>
      <div style="position:absolute; left:50%; top:12%; transform:translateX(-50%); width: min(720px, 92vw); background:#fff; border:1px solid #e5e7eb; border-radius:16px; box-shadow:0 16px 40px rgba(0,0,0,.12); overflow:hidden;">
        <div style="display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid #f2f2f2;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm9-1-4.35-4.35" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input id="nav-search-input" type="text" placeholder="搜索文章标题、标签或描述" style="flex:1; padding:10px 12px; border:1px solid #e5e7eb; border-radius:10px; outline:none;" />
          <button id="search-close" style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border:none; background:transparent; cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6l12 12M18 6L6 18" stroke="#777" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div id="nav-search-list" style="max-height:52vh; overflow:auto;">
        </div>
        <div id="nav-search-empty" style="display:none; padding:24px; text-align:center; color:#777; font-size:14px;">无搜索结果</div>
    </div>
    </div>
    
    <ThemeSwitcher client:only="vue" showModeSwitch={isHomePage} />
    <BackToTop client:only="vue" />

    <script>
      import Swup from 'swup';
      const swup = new Swup({
        containers: ['#home-hero', '#pjax-container'],
        animateHistoryBrowsing: true
      });
      window.swupInstance = swup;    swup.hooks.on('page:view', () => {
        document.dispatchEvent(new CustomEvent('swup:page:view'));
      });

      const CONTAINER_ID = 'pjax-container' // This ID is expected to be inside #swup by the content pages
      
      let VIEWER_INSTANCE = null

      function init() {
        emitSidebarHeadings(); 
        enhancePostImages(); 
        setupDonateOverlay(); 
        setupViewer(); 
        wrapTables(); 
        setupCodeCopy();
        revealPage();
        
        // Re-initialize Search logic (events need to be re-attached if elements were replaced, but search overlay is OUTSIDE swup, so it persists!)
        // However, if the user navigated, we might want to ensure everything is clean.
        // Search logic is mostly global.
      }

      // Run on initial load
      init();
      
      // Run on Swup content replacement
      swup.hooks.on('content:replace', () => {
        // Scroll to top or handle hash
        init();
      });

      // Helper functions
      function enhancePostImages(){
        // Look for .prose inside #swup (which contains #pjax-container usually)
        const root = document.querySelector('.post-content-card .prose')
        if (!root) return
        const imgs = Array.from(root.querySelectorAll('img'))
        for (const img of imgs){
          if (img.classList.contains('friend-avatar')) continue
          img.setAttribute('class','posts-img')
          img.setAttribute('loading','lazy')
          img.setAttribute('decoding','async')
          img.setAttribute('referrerpolicy','no-referrer')
          img.style.cursor = 'zoom-in'
          
          img.addEventListener('error', function(){
            const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='800' height='480'><rect width='100%' height='100%' fill='#f5f7fa'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='#999' font-family='system-ui' font-size='16'>图片加载失败</text></svg>"
            this.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
            this.classList.add('img-error')
          }, { once: true })
        }
      }

      function setupViewer(){
        const root = document.querySelector('.post-content-card .prose')
        if (!root || !(window && window.Viewer)) return
        if (VIEWER_INSTANCE && typeof VIEWER_INSTANCE.destroy === 'function') {
          try { VIEWER_INSTANCE.destroy() } catch {}
          VIEWER_INSTANCE = null
        }
        VIEWER_INSTANCE = new window.Viewer(root, {
          navbar: false,
          title: false,
          toolbar: { zoomIn: 1, zoomOut: 1, reset: 1, prev: 1, next: 1 },
          tooltip: false,
          movable: true,
          transition: true,
          backdrop: true,
          filter(image){ try { return image.classList && image.classList.contains('posts-img') } catch { return false } }
        })
      }

      function setupDonateOverlay(){
        // Note: The donate overlay HTML is inside the content (in [slug].astro), so it gets replaced.
        // We need to find it inside the new content.
        const overlay = document.querySelector('.donate-overlay')
        const title = document.querySelector('#donate-title')
        const img = document.querySelector('#donate-qr')
        const closeBtn = document.querySelector('#donate-close')
        const backdrop = overlay ? overlay.querySelector('.donate-backdrop') : null
        
        if (!overlay) return;

        function show(type){
          if (!(overlay instanceof HTMLElement) || !(title instanceof HTMLElement) || !(img instanceof HTMLImageElement)) return
          title.textContent = type === 'wechat' ? '推荐使用微信' : '推荐使用支付宝'
          const src = type === 'wechat' ? '/assets/donate/wechat.png' : '/assets/donate/alipay.png'
          img.src = src
          img.onerror = function(){
            const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='520' height='520'><rect width='100%' height='100%' rx='16' fill='" + (type==='wechat'?'#10b981':'#409eff') + "'/><text x='50%' y='14%' dominant-baseline='middle' text-anchor='middle' fill='#fff' font-family='system-ui' font-size='22'>推荐使用" + (type==='wechat'?'微信':'支付宝') + "</text><rect x='110' y='110' width='300' height='300' rx='12' fill='#f5f7fa' stroke='#e5e7eb'/><text x='50%' y='88%' dominant-baseline='middle' text-anchor='middle' fill='#fff' font-family='system-ui' font-size='16'>请前往捐赠页面查看二维码</text></svg>"
            img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
          }
          overlay.style.display = 'flex'
          document.body.style.overflow = 'hidden'
        }
        function hide(){ if (!(overlay instanceof HTMLElement)) return; overlay.style.display = 'none'; document.body.style.overflow = '' }
        
        const btns = Array.from(document.querySelectorAll('.donate-card [data-donate]'))
        for (const b of btns){ b.addEventListener('click', (e) => { e.preventDefault(); show(b.getAttribute('data-donate')||'') }) }
        if (closeBtn) closeBtn.addEventListener('click', () => hide())
        if (backdrop) backdrop.addEventListener('click', () => hide())
        
        const a = document.querySelector('#article-url')
        if (a && a instanceof HTMLAnchorElement) {
          const url = window.location.origin + window.location.pathname
          a.textContent = url
          a.href = url
        }
      }
      
      function emitSidebarHeadings(){
        const prose = document.querySelector('.prose')
        const hs = []
        if (prose) {
          const nodes = Array.from(prose.querySelectorAll('h2,h3,h4'))
          nodes.forEach((el, i) => {
            const tag = (el.tagName || 'H2').toLowerCase()
            const depth = tag === 'h2' ? 2 : tag === 'h3' ? 3 : 4
            const text = el.textContent || ''
            let slug = el.getAttribute('id') || (text.trim().toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9\-]/g,''))
            if (!slug) slug = `toc-${i}`
            if (!el.getAttribute('id')) el.setAttribute('id', slug)
            hs.push({ slug, text, depth })
          })
        }
        // Sidebar is re-rendered by Swup if it is inside #swup.
        // If Sidebar is a Vue component inside #swup, it needs to be mounted.
        // But Swup destroys it.
        // If Sidebar is outside #swup, we dispatch event.
        try { document.dispatchEvent(new CustomEvent('ajax:updateSidebar', { detail: { headings: hs } })) } catch {}
      }
      
      function revealPage(){
        const c = document.getElementById('pjax-container') // Keep using pjax-container ID for internal styling/reference if needed
        if (c) c.classList.add('page-ready')
      }

      function wrapTables() {
        const tables = document.querySelectorAll('.prose table')
        tables.forEach(table => {
          if (table.parentNode.className !== 'table-wrapper') {
            const wrapper = document.createElement('div')
            wrapper.className = 'table-wrapper'
            table.parentNode.insertBefore(wrapper, table)
            wrapper.appendChild(table)
          }
        })
      }

      function setupCodeCopy() {
        const pres = document.querySelectorAll('.prose pre')
        pres.forEach(pre => {
          if (pre.parentNode.className.includes('code-wrapper')) return
          const wrapper = document.createElement('div')
          wrapper.className = 'code-wrapper'
          pre.parentNode.insertBefore(wrapper, pre)
          wrapper.appendChild(pre)
          const btn = document.createElement('button')
          btn.className = 'copy-btn'
          btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 2h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')
            const text = code ? code.innerText : pre.innerText
            try {
              await navigator.clipboard.writeText(text)
              btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`
              if (window.ElMessage) window.ElMessage({ message: '复制成功', type: 'success', duration: 2000 })
              setTimeout(() => { 
                btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 2h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`
              }, 2000)
            } catch (err) {
              btn.innerHTML = '!'
              if (window.ElMessage) window.ElMessage({ message: '复制失败', type: 'error', duration: 2000 })
            }
          })
          wrapper.appendChild(btn)
        })
      }
      
      // Search Logic (Global)
      let INDEX = []
      try {
        const el = document.getElementById('search-index')
        INDEX = el ? JSON.parse(el.textContent || '[]') : []
      } catch {}
      if (!Array.isArray(INDEX) || INDEX.length === 0) {
        try {
          fetch('/search-index.json')
            .then((r) => r.json())
            .then((data) => { if (Array.isArray(data)) INDEX = data })
            .catch(() => {})
        } catch {}
      }
      const btn = document.getElementById('nav-search-button')
      const overlay = document.getElementById('search-overlay')
      const backdrop = document.getElementById('search-backdrop')
      const closeBtn = document.getElementById('search-close')
      const input = document.getElementById('nav-search-input')
      const list = document.getElementById('nav-search-list')
      const empty = document.getElementById('nav-search-empty')
      function openOverlay() {
        if (!overlay) return
        overlay.style.display = 'block'
        document.body.style.overflow = 'hidden'
        setTimeout(() => { input && input.focus() }, 0)
      }
      function closeOverlay() {
        if (!overlay) return
        overlay.style.display = 'none'
        document.body.style.overflow = ''
        if (input) input.value = ''
        if (list) list.innerHTML = ''
        if (empty) empty.style.display = 'none'
      }
      function render(items) {
        if (!list || !empty) return
        if (!items.length) {
          list.innerHTML = ''
          empty.style.display = 'block'
          return
        }
        empty.style.display = 'none'
        list.innerHTML = items.slice(0, 12).map((x) => `<a href="/posts/${x.slug}" style="display:block;padding:12px 16px;text-decoration:none;color:#333;border-bottom:1px solid #f2f2f2"><div style="font-weight:600;">${x.title}</div><div style="font-size:12px;color:#666;margin-top:4px;">${(x.tags||[]).join(', ')}</div></a>`).join('')
        const children = Array.from(list.querySelectorAll('a'))
        for (const a of children) {
          a.addEventListener('click', () => { closeOverlay() })
        }
      }
      function search(q) {
        const s = (q || '').trim().toLowerCase()
        if (!s) { list && (list.innerHTML = ''); empty && (empty.style.display = 'none'); return }
        const r = INDEX.filter((x) => x.title.toLowerCase().includes(s) || (x.description||'').toLowerCase().includes(s) || (x.tags||[]).some((t) => (t||'').toLowerCase().includes(s)))
        render(r)
      }
      if (btn) btn.addEventListener('click', () => openOverlay())
      document.addEventListener('click', (e) => {
        const t = e.target
        if (!(t instanceof Element)) return
        const b = t.closest('#nav-search-button') || t.closest('[data-search-trigger="1"]')
        if (b) { e.preventDefault(); openOverlay() }
      })
      if (backdrop) backdrop.addEventListener('click', () => closeOverlay())
      if (closeBtn) closeBtn.addEventListener('click', () => closeOverlay())
      if (input) {
        input.addEventListener('input', () => search(input.value))
        input.addEventListener('keydown', (e) => {
          const v = input.value
          if (e.key === 'Enter') {
            const s = (v||'').trim().toLowerCase()
            const r = INDEX.filter((x) => x.title.toLowerCase().includes(s) || (x.description||'').toLowerCase().includes(s) || (x.tags||[]).some((t) => (t||'').toLowerCase().includes(s)))
            if (r.length) {
              const href = `/posts/${r[0].slug}`
              window.location.href = href
              closeOverlay()
            } else {
              empty && (empty.style.display = 'block')
            }
          }
          if (e.key === 'Escape') closeOverlay()
        })
      }
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openOverlay() }
        if (e.key === 'Escape') closeOverlay()
      })
    </script>
  </body>
</html>
